# ==============================================================================
# TEKKZY COLLEGE OF TECHNOLOGY — AWS SERVERLESS BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your confidential AWS credentials and keys.
# NEVER commit the actual .env file to GitHub or any public repository!
# ==============================================================================

# AWS Region & Environment
AWS_REGION=ap-south-1
STAGE=dev

# AWS IAM Credentials (Used for deployment & local emulation)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS Cognito User Pool (For Student, Faculty & Staff Authentication)
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Amazon S3 Bucket (For Marksheets, ID Proofs, and Resumes)
DOCUMENTS_BUCKET_NAME=tekkzy-college-documents-dev

# DynamoDB Table Overrides (Defaults match serverless.yml if omitted)
COLLEGE_USER_TABLE_NAME=college_user_profile_dev
COLLEGE_ADMISSIONS_TABLE_NAME=college_admissions_dev
COLLEGE_INQUIRIES_TABLE_NAME=college_inquiries_dev
COLLEGE_PLACEMENTS_TABLE_NAME=college_placements_dev
COLLEGE_SECURITY_TABLE_NAME=college_security_logs_dev
COLLEGE_NOTICES_TABLE_NAME=college_notices_dev
COLLEGE_CONFIG_TABLE_NAME=college_config_variable_dev

# Multi-Tenancy Default Institution Identifier
DEFAULT_INSTITUTION_ID=INST_TEKKZY_001
