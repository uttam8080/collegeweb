{
  "info": {
    "name": "TEKKZY College of Technology — Backend APIs",
    "description": "Multi-Tenant Serverless APIs for TEKKZY College of Technology platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "institutionId",
      "value": "INST_TEKKZY_001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Admissions",
      "item": [
        {
          "name": "Apply for Admission (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "institutionId", "value": "{{institutionId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicantName\": \"Aarav Sharma\",\n  \"applicantEmail\": \"aarav.sharma@example.in\",\n  \"applicantPhone\": \"+919876543210\",\n  \"programName\": \"B.Tech Computer Science & Engineering\",\n  \"qualifyingExam\": \"JEE Advanced\",\n  \"examScore\": \"98.5 Percentile\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admissions/apply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admissions", "apply"]
            }
          }
        },
        {
          "name": "Get Application Status (GET)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "institutionId", "value": "{{institutionId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admissions/TAT-APP-SAMPLE-001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admissions", "TAT-APP-SAMPLE-001"]
            }
          }
        },
        {
          "name": "List All Applications (GET)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "institutionId", "value": "{{institutionId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admissions"]
            }
          }
        }
      ]
    },
