# ==============================================================================
# TEKKZY COLLEGE OF TECHNOLOGY — FRONTEND VITE ENVIRONMENT VARIABLES
# Note: Vite exposes variables starting with VITE_ to the browser bundle.
# NEVER put private AWS secret keys in the frontend!
# ==============================================================================

# Backend API Gateway Endpoint
# Local testing: http://localhost:5000
# Production AWS: https://<api-id>.execute-api.ap-south-1.amazonaws.com/dev
VITE_API_BASE_URL=http://localhost:5000

# Institution Tenant ID (Partition Key for this college deployment)
VITE_INSTITUTION_ID=INST_TEKKZY_001

# AWS Cognito Client-Side Authentication Configuration
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Gemini AI Assistant API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here
